{
  "name": "zhiguan-purchase-decision-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "allowScripts": {
    "fsevents": false
  },
  "scripts": {
    "check:toolchain": "node scripts/verify-toolchain.mjs",
    "check:dependencies": "node scripts/check-dependency-policy.mjs",
    "check:currency": "node scripts/generate-currency-table.mjs --check",
    "preinstall": "node scripts/verify-toolchain.mjs",
    "prebuild": "npm run check:toolchain && npm run check:dependencies && npm run check:currency && npm run typecheck && npm run scope:check && node scripts/build-manifest.mjs --preflight",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:delivery": "node --test tests/delivery/*.test.mjs",
    "test:all": "npm run test:delivery && npm test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "scope:check": "node scripts/scope-guard.mjs",
    "check:artifact": "node scripts/build-manifest.mjs --check",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "node scripts/build-manifest.mjs --preflight && vite build && node scripts/build-manifest.mjs && npm run check:artifact",
    "prepreview": "npm run check:toolchain && npm run check:artifact",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "prepreview:lan": "npm run check:toolchain && npm run check:artifact",
    "preview:lan": "node scripts/preview-lan.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
